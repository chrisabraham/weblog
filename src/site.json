{
  "projects": [
    {
      "name": "Blackbox",
      "status": "active",
      "started": "September 2026",
      "url": "",
      "about": "My private command-line secretary, built with Claude Code and running on a small server I SSH into. I talk to it in plain English: it runs my morning brief, watches unread mail, keeps Todoist honest, triages Upwork leads, drafts proposals, and writes my diary every night whether I remember to or not. Most of the posts here are about it."
    },
    {
      "name": "Adjutant",
      "status": "planned",
      "started": "not yet",
      "url": "",
      "about": "A public, de-personalized spin-off of Blackbox: the patterns written up so other people can read the code and take what's useful. Waiting until Blackbox has had a few more weeks of real use."
    },
    {
      "name": "This weblog",
      "status": "live lab",
      "started": "October 2026",
      "url": "https://chrisabraham.net/",
      "about": "A static site generated by one Python script on GitHub Pages. AI writes the posts from my prompts and the build shows each prompt under its post."
    },
    {
      "name": "The Chris Abraham Show site",
      "status": "live lab",
      "started": "October 2026",
      "url": "https://thechrisabrahamshow.com/",
      "about": "A mirror of my podcast feed with a page for every episode, transcripts, articles, a glossary, and a hand-built back-of-the-book index of all the episodes. A GitHub Action rebuilds it every morning."
    },
    {
      "name": "Hill Mole",
      "status": "live lab",
      "started": "restored October 2026",
      "url": "https://hillmole.com/",
      "about": "My serialized spy novel from the Movable Type years, brought back to its 2005 look, with a reader's glossary, an index, sourced endnotes, and an atlas added around the untouched chapters."
    },
    {
      "name": "christopherabraham.com",
      "status": "live lab",
      "started": "rebuilt 2026",
      "url": "https://christopherabraham.com/",
      "about": "My consulting site: SEO and AI search guides, case studies, and services. One of four sites I run as open SEO, AEO, and GEO experiments."
    },
    {
      "name": "gerriscorp.com",
      "status": "live lab",
      "started": "rebuilt 2026",
      "url": "https://gerriscorp.com/",
      "about": "The site for my firm, Gerris Corp, with its own guides and case studies, kept deliberately distinct from my personal consulting site."
    },
    {
      "name": "AI visibility tracker",
      "status": "active",
      "started": "October 2026",
      "url": "",
      "about": "A small script that asks AI assistants a fixed set of questions and records whether my sites get named and cited. It runs only when I start it, because every run costs real API money."
    }
  ],
